{
  "_comment": "PiP-Disabler-Full Settings.cs 汉化映射表（源: Settings.cs, 1.5.0）。sec/key 为上游英文原文（唯一匹配键），newKey/desc 为中文译文。desc 数组的每个元素是一段，段间以 \\n 连接。仅供 Tools/apply_settings_zh.ps1 与 Tools/migrate_cfg_names.ps1 使用，不参与编译。",
  "sections": {
    "General": "通用",
    "Hacks": "高级技巧",
    "Graphics": "画面",
    "Debug": "调试",
    "Global Mesh Surgery settings": "全局网格手术",
    "Per scope settings": "当前瞄具设置",
    "Scope Effects": "镜内效果"
  },
  "entries": [
    { "sec": "General", "key": "Mod Enabled", "newKey": "启用模组", "desc": ["整个模组的总开关。"] },
    { "sec": "General", "key": "Mod Toggle Key", "newKey": "模组开关按键", "desc": ["切换模组总开关的按键。"] },
    { "sec": "General", "key": "Auto Disable For NV/Thermals", "newKey": "夜视/热成像自动禁用", "desc": ["对热成像/夜视瞄具自动禁用本模组。"] },
    { "sec": "General", "key": "Auto Bypass Name Contains", "newKey": "自动绕过名称包含", "desc": ["分号分隔的列表。瞄具的对象名或瞄具 key 只要包含其中任意一项，就会被绕过（走游戏原版渲染）。"] },
    { "sec": "General", "key": "Scope Blacklist Names", "newKey": "黑名单瞄具名", "desc": ["分号分隔的瞄具 key 列表，列出的瞄具会绕过本模组（走原版渲染）。"] },
    { "sec": "General", "key": "Scope Blacklist Toggle Entry Key", "newKey": "黑名单添加按键", "desc": ["开镜状态下按下该键，把当前瞄具加入/移出黑名单。"] },
    { "sec": "General", "key": "Scope Whitelist Names", "newKey": "白名单瞄具名", "desc": ["分号分隔的允许瞄具列表。留空 = 忽略白名单（全部瞄具生效）。"] },
    { "sec": "General", "key": "Scope Whitelist Toggle Entry Key", "newKey": "白名单添加按键", "desc": ["开镜状态下按下该键，把当前瞄具加入/移出白名单。"] },
    { "sec": "General", "key": "FOV Fix Behaviour", "newKey": "FOV 修复行为", "desc": ["启用后，1x 的 FOV 会采用游戏设置里的 FOV 值。"] },
    { "sec": "General", "key": "Global Scope Scaling Multiplier", "newKey": "全局瞄具缩放系数", "desc": ["统一乘以所有瞄具的缩放。如果你觉得瞄具整体偏小或偏大，可以调这一项。"] },
    { "sec": "General", "key": "Global Reticle Scaling Multiplier", "newKey": "全局准星缩放系数", "desc": ["统一乘以所有准星的缩放。如果你觉得准星整体偏小或偏大，可以调这一项。"] },
    { "sec": "Hacks", "key": "ADS Scope Alignment Angle Tolerance", "newKey": "ADS 对准角度容差", "desc": ["冲刺或姿态切换之后，当前瞄具瞄准轴与主相机之间的最大夹角（度）；超过这个角度时模组暂不生效。"] },
    { "sec": "Hacks", "key": "Post Sprint ADS Gate Duration", "newKey": "冲刺后 ADS 门控时长", "desc": ["冲刺结束后，瞄具对准门控持续生效的时间。"] },
    { "sec": "Hacks", "key": "Bypass During Stance Transitions", "newKey": "姿态切换时绕过", "desc": ["在站姿与卧姿之间切换时绕过本模组（走原版渲染）。"] },
    { "sec": "Hacks", "key": "Post Stance ADS Gate Duration", "newKey": "姿态后 ADS 门控时长", "desc": ["站姿/卧姿切换结束后，瞄具对准门控持续生效的时间。"] },
    { "sec": "General", "key": "Baseline FOV", "newKey": "基准 FOV", "desc": ["计算放大后 FOV 时使用的基准（若设为 50，则 2x 就是 25°）。", "注意：分档变倍瞄具的 1x 始终强制为 35°。"] },
    { "sec": "General", "key": "FOV Animation Duration", "newKey": "FOV 过渡时长", "desc": ["切换放大倍率时 FOV 过渡的时长。"] },
    { "sec": "Hacks", "key": "Bypass during reload", "newKey": "换弹时绕过", "desc": ["换弹期间绕过本模组（走原版渲染）。"] },
    { "sec": "Hacks", "key": "Reload Bypass Modifier", "newKey": "换弹绕过强度", "desc": ["调整换弹绕过的持续时间：数值越大，绕过时间越短。"] },
    { "sec": "Hacks", "key": "Scale Sway With Camera FOV", "newKey": "晃动随 FOV 缩放", "desc": ["开镜时按当前 FOV 成比例降低武器晃动。"] },
    { "sec": "Hacks", "key": "Sway Modifier", "newKey": "晃动强度", "desc": ["调整晃动削减的强度。"] },
    { "sec": "Hacks", "key": "Manual Weapon Scale", "newKey": "手动武器缩放", "desc": ["开镜时直接设定骨架（ribcage）补偿缩放。数值越大，武器看起来越小。"] },
    { "sec": "Hacks", "key": "Visual Recoil Compensation", "newKey": "视觉后坐力补偿", "desc": ["仅影响渲染：低 FOV 下把屏幕平面相机朝瞄具相机偏移，用于补偿开镜后的后坐与对准。负值反向。0 = 关闭。"] },
    { "sec": "Graphics", "key": "Keep scoped LOD Bias until inventory is opened", "newKey": "开镜 LOD 保留至背包", "desc": ["启用后，退出开镜时 LOD 偏移不会立即恢复，而是保留到打开背包/搜刮界面，或成功转移物品之后。", "关闭后，退出开镜立即恢复 LOD 偏移。"] },
    { "sec": "Graphics", "key": "Manual LOD Bias", "newKey": "手动 LOD 偏移", "desc": ["开镜时手动设定的 LOD 偏移。", "0 = 自动（放大倍率 × 自动 LOD 偏移系数）。", "数值过高会影响性能！"] },
    { "sec": "Graphics", "key": "Auto LOD bias multiplier", "newKey": "自动 LOD 偏移系数", "desc": ["顾名思义。", "数值过高会影响性能！"] },
    { "sec": "Hacks", "key": "Suppress Fire Mode Switch Movement", "newKey": "抑制射击模式切换动作", "desc": ["切换射击模式时不播放对应的武器动作，但模式切换照常生效。"] },
    { "sec": "Hacks", "key": "Suppress Magnification Switch Movement", "newKey": "抑制倍率切换动作", "desc": ["切换瞄具倍率时不播放对应的武器动作，但倍率切换照常生效。"] },
    { "sec": "Hacks", "key": "Force Recoil Return To Zero", "newKey": "后坐力强制归零", "desc": ["后坐结束后，强制把武器手部旋转的静止点归零，而不是使用塔科夫自带的小幅随机偏移。"] },
    { "sec": "Global Mesh Surgery settings", "key": "PlaneOffsetMeters", "newKey": "平面偏移(米)", "desc": ["沿平面法线方向施加的偏移（米）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane1Radius", "newKey": "Plane1 半径(米)", "desc": ["圆柱/锥形切割的近端半径（米，靠相机一侧）。", "瞄具镜片半径通常在 0.01-0.02 米左右。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane1OffsetMeters", "newKey": "Plane1 偏移(米)", "desc": ["Plane1 相对 linza/backLens 原点沿枪管轴线的偏移（米）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane2Position", "newKey": "Plane2 深度(0-1)", "desc": ["Plane2 的剖面位置（0..1），以近端为基准。", "改变「切割长度(米)」时，该平面到近端的世界空间深度保持不变。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane2Radius", "newKey": "Plane2 半径(米)", "desc": ["Plane2 处的半径（米）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane3Position", "newKey": "Plane3 深度(0-1)", "desc": ["Plane3 的归一化深度：近端 (0) 到远端 (1)。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane3Radius", "newKey": "Plane3 半径(米)", "desc": ["Plane3 处的半径（米）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane4Position", "newKey": "Plane4 深度(0-1)", "desc": ["Plane4 的归一化深度：近端 (0) 到远端 (1)。通常为 1。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Plane4Radius", "newKey": "Plane4 半径(米)", "desc": ["Plane4 处的半径（米，远离玩家一侧）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "CutStartOffset", "newKey": "切割起点偏移(米)", "desc": ["近端切割平面从 backLens 向相机一侧后退的距离。", "近端平面固定在：backLens - (偏移 × boreAxis)。", "0 = 正好从 backLens 开始；0.05 = 后退 5cm（可切到镜筒内壁结构）。", "改变「切割长度(米)」不会移动这个平面。"] },
    { "sec": "Global Mesh Surgery settings", "key": "CutLength", "newKey": "切割长度(米)", "desc": ["切割从近端平面向前（朝物镜方向）延伸的距离。", "远端平面位于：nearPlane + (长度 × boreAxis)。", "改变该值时，只有远端平面会移动。"] },
    { "sec": "Global Mesh Surgery settings", "key": "NearPreserveDepth", "newKey": "近端保留深度(米)", "desc": ["从近端切割平面起、完全不切割任何几何体的深度（米）。", "保留最靠近相机的目镜镜身，这样开镜时还能看到一圈细环框住准星。", "0.01 = 1cm 圆环（默认）。0.02-0.04 = 更粗的圆环。", "0 = 关闭（近端平面即开始切割，会全部切掉）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Reticle Base Size", "newKey": "准星基础尺寸", "desc": ["准星的尺寸。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Mesh Reticle Min Scale", "newKey": "网格准星最小缩放", "desc": ["归一化与变焦之后，网格准星的最终最小缩放。0 = 关闭。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Mesh Reticle Max Scale", "newKey": "网格准星最大缩放", "desc": ["归一化与变焦之后，网格准星的最终最大缩放。0 = 关闭。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Mesh Reticle Normalized Scale", "newKey": "网格准星归一化缩放", "desc": ["网格准星包围盒归一化之后乘上的系数。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Mesh Reticle Minimum Stroke Enabled", "newKey": "网格准星最小线宽", "desc": ["绘制网格准星时做小幅屏幕空间膨胀，避免细部在降采样后消失。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Mesh Reticle Minimum Stroke Pixels", "newKey": "网格准星线宽像素", "desc": ["网格准星的最小可见粗细（屏幕像素，近似值）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "ExpandSearchToWeaponRoot", "newKey": "搜索扩展到武器根", "desc": ["让网格切割器作用到整把武器。"] },
    { "sec": "Debug", "key": "DebugShowHousingMask", "newKey": "调试显示镜身遮罩", "desc": ["在镜片模板（stencil）遮罩所在位置叠加红色显示。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Auto derive cut region from scope geometry", "newKey": "自动推导切割区", "desc": ["围绕切割轴测量瞄具自身的 renderer 包围盒，并据此放宽切割半径包络，而不是直接采信按瞄具手调的常数（那批常数是针对 4.0.13 的 prefab 调出来的）。", "最终取值按 max(推导值, 手调值) 合成，因此自动模式只会比手调剖面切得更多，绝不会更少。", "关闭 = 与之前的行为完全一致。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Auto derive margin", "newKey": "自动推导边距", "desc": ["施加在推导半径上的系数：R = min(max(R_geo, R_manual) × 边距 + 额外半径, 最大半径)。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Auto derive extra radius meters", "newKey": "自动推导额外半径(米)", "desc": ["乘以边距系数之后额外叠加的固定值（米）。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Auto derive max radius meters", "newKey": "自动推导最大半径(米)", "desc": ["所有推导半径的上限（米）。手调值仍会作为下限生效，因此这个上限不会让切割比原来更小。"] },
    { "sec": "Global Mesh Surgery settings", "key": "Auto derive log derived profile", "newKey": "自动推导日志输出", "desc": ["每次推导时输出一次推导出的切割剖面（单行，无逐帧开销）。", "不依赖「调试日志」，可单独开启。"] },
    { "sec": "Per scope settings", "key": "Save custom settings key", "newKey": "保存按键", "desc": ["开镜状态下按下该键，把本分类下所有数值按当前瞄具 key 保存到 custom_mesh_surgery_settings.json。"] },
    { "sec": "Per scope settings", "key": "DeleteCustomMeshSurgerySettingsKey", "newKey": "删除按键", "desc": ["开镜状态下按下该键，从 custom_mesh_surgery_settings.json 中删除当前瞄具 key 的网格手术设置。"] },
    { "sec": "Per scope settings", "key": "PlaneOffsetMeters", "newKey": "平面偏移(米)", "desc": ["按瞄具自定义的平面偏移，沿平面法线方向（米）。"] },
    { "sec": "Per scope settings", "key": "Plane1Radius", "newKey": "Plane1 半径(米)", "desc": ["按瞄具自定义的近端半径（米）。"] },
    { "sec": "Per scope settings", "key": "Plane1OffsetMeters", "newKey": "Plane1 偏移(米)", "desc": ["按瞄具自定义的 Plane1 偏移（米）。"] },
    { "sec": "Per scope settings", "key": "Plane2Position", "newKey": "Plane2 深度(0-1)", "desc": ["按瞄具自定义的 Plane2 位置（0..1）；改变「切割长度(米)」时以近端为基准。"] },
    { "sec": "Per scope settings", "key": "Plane2Radius", "newKey": "Plane2 半径(米)", "desc": ["按瞄具自定义的 Plane2 半径（米）。"] },
    { "sec": "Per scope settings", "key": "Plane3Position", "newKey": "Plane3 深度(0-1)", "desc": ["按瞄具自定义的 Plane3 深度（0..1）。"] },
    { "sec": "Per scope settings", "key": "Plane3Radius", "newKey": "Plane3 半径(米)", "desc": ["按瞄具自定义的 Plane3 半径（米）。"] },
    { "sec": "Per scope settings", "key": "Plane4Position", "newKey": "Plane4 深度(0-1)", "desc": ["按瞄具自定义的 Plane4 深度（0..1）。"] },
    { "sec": "Per scope settings", "key": "Plane4Radius", "newKey": "Plane4 半径(米)", "desc": ["按瞄具自定义的 Plane4 半径（米）。"] },
    { "sec": "Per scope settings", "key": "CutStartOffset", "newKey": "切割起点偏移(米)", "desc": ["按瞄具自定义的切割起点偏移（米）。"] },
    { "sec": "Per scope settings", "key": "CutLength", "newKey": "切割长度(米)", "desc": ["按瞄具自定义的切割长度（米）。"] },
    { "sec": "Per scope settings", "key": "NearPreserveDepth", "newKey": "近端保留深度(米)", "desc": ["按瞄具自定义的近端保留深度（米）。"] },
    { "sec": "Per scope settings", "key": "Reticle Size", "newKey": "准星尺寸", "desc": ["针对准星不随倍率缩放的瞄具，设定该瞄具的准星尺寸。需要保存后才会生效。"] },
    { "sec": "Per scope settings", "key": "Reticle Size Multiplier", "newKey": "准星尺寸系数", "desc": ["施加在按瞄具准星尺寸上的系数。1 = 不改变。需要保存后才会生效。"] },
    { "sec": "Per scope settings", "key": "Variable Reticle Minimum Size", "newKey": "变量准星最小尺寸", "desc": ["按瞄具自定义的准星最小尺寸。最大或最小只要有一个为 0，此项就不起作用。需要保存后才会生效。"] },
    { "sec": "Per scope settings", "key": "Variable Reticle Maximum Size", "newKey": "变量准星最大尺寸", "desc": ["按瞄具自定义的准星最大尺寸。最大或最小只要有一个为 0，此项就不起作用。需要保存后才会生效。"] },
    { "sec": "Per scope settings", "key": "Weapon Scale Min Magnification", "newKey": "最小倍率武器缩放", "desc": ["按瞄具自定义：最小放大倍率下的骨架缩放。0 = 使用全局「手动武器缩放」。需要保存后才会生效。数值越大，武器看起来越小。"] },
    { "sec": "Per scope settings", "key": "Weapon Scale Max Magnification", "newKey": "最大倍率武器缩放", "desc": ["按瞄具自定义：最大放大倍率下的骨架缩放。0 = 使用全局「手动武器缩放」。需要保存后才会生效。数值越大，武器看起来越小。"] },
    { "sec": "Per scope settings", "key": "Weapon Scale Multiplier", "newKey": "武器缩放系数", "desc": ["同时施加在按瞄具武器缩放上下限上的系数。1 = 不改变。需要保存后才会生效。"] },
    { "sec": "Per scope settings", "key": "Visual Recoil Compensation", "newKey": "视觉后坐力补偿", "desc": ["按瞄具自定义的视觉后坐力补偿。0 = 使用全局「视觉后坐力补偿」。需要保存后才会生效。负值反向。"] },
    { "sec": "Per scope settings", "key": "Vignette Opacity", "newKey": "暗角不透明度", "desc": ["按瞄具自定义的暗角不透明度。0 = 使用「镜内效果」段的默认值。"] },
    { "sec": "Per scope settings", "key": "Vignette Radius", "newKey": "暗角半径", "desc": ["按瞄具自定义的暗角半径。0 = 使用「镜内效果」段的默认值。"] },
    { "sec": "Per scope settings", "key": "Vignette Softness", "newKey": "暗角柔化", "desc": ["按瞄具自定义的暗角柔化。0 = 使用「镜内效果」段的默认值。"] },
    { "sec": "Per scope settings", "key": "ExpandSearchToWeaponRoot", "newKey": "搜索扩展到武器根", "desc": ["按瞄具自定义：把搜索根扩展到 Weapon_root。"] },
    { "sec": "Scope Effects", "key": "Vignette", "newKey": "暗角", "desc": ["在瞄具通光孔周围绘制一圈圆形暗角。"] },
    { "sec": "Scope Effects", "key": "Vignette Opacity", "newKey": "暗角不透明度", "desc": ["镜片暗角环的最大不透明度（0=不可见，1=全黑）。"] },
    { "sec": "Scope Effects", "key": "Vignette Radius", "newKey": "暗角半径", "desc": ["镜片暗角的内部透明半径（0=从中心开始变暗，0.5=外半圈变暗，1=仅边缘变暗）。"] },
    { "sec": "Scope Effects", "key": "Vignette Softness", "newKey": "暗角柔化", "desc": ["用于渐变过渡的暗角半径比例（0=硬边，1=完全渐变）。"] },
    { "sec": "Scope Effects", "key": "Scope Shadow", "newKey": "镜身阴影", "desc": ["除镜片遮罩范围之外，全屏叠加一层黑色阴影。"] },
    { "sec": "Debug", "key": "DebugShowScopeShadowMask", "newKey": "调试显示阴影遮罩", "desc": ["把阴影镜片遮罩以绿色叠加显示，用于调试。"] },
    { "sec": "Scope Effects", "key": "ScopeShadow Persist On Unscope", "newKey": "退出开镜保留阴影", "desc": ["退出 ADS 后继续显示镜身阴影，直到 FOV 恢复完成；当「FOV 过渡时长」设为 0 时比较有用。"] },
